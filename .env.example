# Copy to .env. Never commit .env.

# Airwallex sandbox: only needed for run_live.py and scripts/ (the demo server does not use them)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_DEPOSIT_ACCOUNT_ID=

# Email signal: the first provider configured wins; none set = deterministic keyword rule
GROQ_API_KEY=
# LLM_BASE_URL=          # any OpenAI-compatible server (Ollama, OpenRouter, ...)
# LLM_API_KEY=
# ANTHROPIC_API_KEY=
# TREASURY_LLM_MODEL=    # comma-separated, tried in order

# Demo server
# PORT=8000
# HOST=127.0.0.1
# TRUST_PROXY=1          # behind a load balancer: rate-limit on X-Forwarded-For
# PER_IP_PER_MIN=6
# LLM_PER_DAY=300
